PORT=3000
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_MS=240000
ANALYSIS_JOB_TTL_MS=1800000
MAX_CONTEXT_CHARS=60000
QUESTION_FILE_CONTEXT_CHARS=40000
MAX_UPLOAD_MB=20
DEFAULT_DAY_RATE=10000
ARI_PUBLIC_BASE_URL=http://localhost:3101
LEX_API_BASE_URL=http://localhost:3000
LEX_API_TOKEN=

# Microsoft SSO. Leave client values blank to disable local auth.
MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3101/auth/callback
MICROSOFT_ALLOWED_EMAIL_DOMAIN=
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=false

# Customer user story storage.
MONGODB_URI=
# Use the same Mongo URI and DB name as contract-bot, but keep Ari stories in
# their own collection.
MONGODB_DB_NAME=dbsi-contract-agent
MONGODB_STORIES_COLLECTION=customer_user_stories
MONGODB_ENGAGEMENTS_COLLECTION=engagement_registry
ORG_SLUG=devboxph

# Optional S3 storage for uploaded source documents.
# Reuse the same S3 bucket/credentials as contract-bot, but use Ari's own prefix.
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_PREFIX=analyst-bot
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ARI_S3_ENDPOINT=
ARI_S3_FORCE_PATH_STYLE=false
ARI_S3_SIGNED_URL_SECONDS=900
